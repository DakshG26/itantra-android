<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- ── Top Header Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/isro_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iTANTRA"
                        android:textColor="@color/isro_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@color/isro_blue_light"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="ISRO SIH26173"
                        android:fontFamily="monospace"
                        android:textColor="@color/isro_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline Transceiver (24 bps • 0% Internet)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSos"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/tactical_red_light"
                android:text="🚨 SOS"
                android:textColor="@color/tactical_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── 3-Digit Radio Channel Code Card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/isro_blue_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Channel Code Display & Connect Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR CHANNEL:"
                            android:fontFamily="monospace"
                            android:textColor="@color/isro_blue"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvChannelCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="#101"
                            android:textColor="@color/isro_blue_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Quick 3-Digit Connect Input -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etTargetCode"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@android:drawable/edit_text"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:hint="3-Digit #"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnConnectCode"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="@color/isro_blue"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Link #"
                            android:textColor="@color/bg_surface"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Auto-Found Peer Quick Button Banner (Visible when UDP finds a peer) -->
                <Button
                    android:id="@+id/btnAutoFoundPeer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/tactical_green_light"
                    android:text="📡 Found Radio Node #001 — Tap to Link Instantly"
                    android:textColor="@color/tactical_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Action Buttons: Bluetooth Scan & More -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@color/tactical_green" />

                    <TextView
                        android:id="@+id/tvP2pStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="Standby • Ready for incoming radio"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnBluetoothScan"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="🔵 Bluetooth"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ── Language Selector Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Lang:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCompressionStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="18B • 2,666× savings"
            android:textColor="@color/tactical_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Quick Indic Preset Buttons Bar ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_page"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetHindi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🇮🇳 Hindi Alert"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetTamil"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🌊 Tamil Rescue"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetMarathi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⛰️ Marathi Landslide"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetEnglish"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="📡 ISRO Mission"
                android:textSize="10sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Message Thread ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        tools:listitem="@layout/item_message" />

    <!-- ── Hex Token Bar ── -->
    <TextView
        android:id="@+id/tvHexTokenBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/isro_blue_dark"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="4dp"
        android:text="[0x54 0x01 0x00 0x8A 0x3F 0x1B 0x4C 0x82 0x9D 0x31 0xFA 0x07 0x88 0x93 0x2C 0xE1 0x4F 0x92]"
        android:textColor="@color/isro_accent"
        android:textSize="9sp" />

    <!-- ── Bottom Input & Push-To-Talk Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPtt"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/isro_blue"
                android:text="🎙️ Mic"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="@string/hint_type_message"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/isro_blue"
                android:contentDescription="Transmit" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
