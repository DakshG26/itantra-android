<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ─── 1. Top Mission Glass Header ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:elevation="2dp"
            android:orientation="vertical">

            <!-- Mission Active Ticker Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface_low"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/isro_blue" />

                <TextView
                    android:id="@+id/tvP2pStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" MISSION ACTIVE • 1.2 kbps"
                    android:textColor="@color/isro_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvCompressionStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,666× SAVINGS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iTantra"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISRO SIH26173"
                    android:textColor="@color/isro_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@color/isro_blue_light"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvChannelCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#001"
                    android:textColor="@color/isro_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@color/bg_surface_container"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── 2. Main Scrollable Content ─── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Auto Peer Discovery Banner -->
                <Button
                    android:id="@+id/btnAutoFoundPeer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡 Peer Found on Mesh (Tap to Link)"
                    android:textColor="@color/bg_surface_card"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/isro_blue"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <!-- Network Spectrum & Neural Link Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_clean"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡 Network Spectrum • 24 bps"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPLINK ACTIVE"
                            android:textColor="@color/isro_blue"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="@color/isro_blue_light"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp" />
                    </LinearLayout>

                    <!-- Wave Visualizer Text -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=" ▂▃▅▆▇█▇▆▅▃ ▂▃▅▆▇█▇▆▅▃ ▂▃▅▆▇█"
                        android:textColor="@color/isro_blue"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:background="@color/bg_surface_low"
                        android:padding="8dp" />

                    <!-- STT / TTS Metrics Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/bg_surface_low"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INCOMING (STT)"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="98.4%"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/bg_surface_low"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OUTGOING (TTS)"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="99.1%"
                                android:textColor="@color/isro_blue"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Language Selector Spinner -->
                    <Spinner
                        android:id="@+id/spLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/bg_surface_low"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Offline 3-Digit Channel Linker -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_clean"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline 3-Digit Direct Linker"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etTargetCode"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Type # (e.g. 125)"
                            android:inputType="number"
                            android:maxLength="4"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="13sp"
                            android:background="@color/bg_surface_low"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <Button
                            android:id="@+id/btnConnectCode"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Link Phone"
                            android:textColor="@color/bg_surface_card"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/isro_blue"
                            android:layout_marginStart="8dp" />

                        <Button
                            android:id="@+id/btnBluetoothScan"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="BT Scan"
                            android:textColor="@color/isro_blue"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/isro_blue_light"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Indic Quick Presets Bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPresetHindi"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🇮🇳 Chamoli Alert"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:backgroundTint="@color/bg_surface_card"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnPresetTamil"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🌊 Tamil Coastal"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:backgroundTint="@color/bg_surface_card"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnPresetMarathi"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⛰️ Ghats Landslide"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:backgroundTint="@color/bg_surface_card"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnPresetEnglish"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="📡 ISRO Base"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:backgroundTint="@color/bg_surface_card"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnSos"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🚨 SOS"
                            android:textColor="@color/tactical_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/tactical_red_light" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Tactical Comms Chat Stream -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_clean"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tactical Comms Stream"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMessages"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_message" />

                    <!-- Live Hex Token Bar -->
                    <TextView
                        android:id="@+id/tvHexTokenBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📦 18B Hex Token: Ready"
                        android:textColor="@color/isro_accent"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:background="@color/bg_surface_low"
                        android:padding="6dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Text Input & Send Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Type tactical dispatch..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp"
                        android:background="@drawable/bg_card_clean"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <Button
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Send"
                        android:textColor="@color/bg_surface_card"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/isro_blue"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ─── 3. Floating PTT Button ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnPtt"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:text="🎤\nPTT"
                android:textColor="@color/bg_surface_card"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/isro_blue"
                android:elevation="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold to Speak"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@color/bg_surface_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="2dp"
                android:elevation="1dp" />
        </LinearLayout>

        <!-- ─── 4. Bottom Navigation Bar ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/bg_surface"
            android:orientation="horizontal"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Dashboard"
                android:textColor="@color/isro_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Logs"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Languages"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Config"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
